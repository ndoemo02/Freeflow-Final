y/szczegoly-pakietu?OfferID=254294"> <div class="booklet__img-hld"> <div class="booklet__img js-img-lazyliquid"> <img class="js-img-lazy" src="/img/blank.gif" data-src="https://r.profitroom.com/rezydencjahotel/images/offers/thumbs/340x200/4JIrJZt2PHpi9Umw.jpg" alt="Biznes Junior Suite" /> </div> </div> <div class="booklet__text-hld"> <div class="booklet__title-hld"> <h3 class="booklet__title t-item-title">Biznes Junior Suite</h3> </div> <div class="booklet__price-hld"> <span class="from">od</span> <span class="price"> <span class="PriceValue"><span class="CurrencyPrefix"></span><span class="CurrencyValue">906</span><span class="CurrencySeparator"></span><span class="CurrencyDecimals"></span><span class="CurrencySuffix">zł</span></span></span> <span class="rate">/noc</span> </div> <ul class="booklet__special-info"> <li> <span class="icon icon-clock"></span> <span class="label">dowolna dł. pobytu</span> </li> <li> <span class="icon icon-meal"></span> <span class="label">HB – Śniadanie i obiadokolacja</span> </li> </ul> </div> </a> <a class="booklet booklet--offer-slider" href="/oferty/szczegoly-pakietu?OfferID=249346"> <div class="booklet__img-hld"> <div class="booklet__img js-img-lazyliquid"> <img class="js-img-lazy" src="/img/blank.gif" data-src="https://r.profitroom.com/rezydencjahotel/images/offers/thumbs/340x200/HAgYVJH2yvGbDAMs.jpg" alt="STAY PASS" /> </div> </div> <div class="booklet__text-hld"> <div class="booklet__title-hld"> <h3 class="booklet__title t-item-title">STAY PASS</h3> </div> <div class="booklet__price-hld"> <span class="from">od</span> <span class="price"> <span class="PriceValue"><span class="CurrencyPrefix"></span><span class="CurrencyValue">385</span><span class="CurrencySeparator"></span><span class="CurrencyDecimals"></span><span class="CurrencySuffix">zł</span></span></span> <span class="rate">/noc</span> </div> <ul class="booklet__special-info"> <li> <span class="icon icon-clock"></span> <span class="label">dowolna dł. pobytu</span> </li> <li> <span class="icon icon-meal"></span> <span class="label">Pełne wyżywienie</span> </li> </ul> </div> </a> <a class="booklet booklet--offer-slider" href="/oferty/kuszaco-niska-cena"> <div class="booklet__img-hld"> <div class="booklet__img js-img-lazyliquid"> <img class="js-img-lazy" src="/img/blank.gif" data-src="https://r.profitroom.com/rezydencjahotel/images/offers/thumbs/340x200/sFYsQaQsxiTkzD6a.jpg" alt="Kusząco Niska Cena" /> </div> </div> <div class="booklet__text-hld"> <div class="booklet__title-hld"> <h3 class="booklet__title t-item-title">Kusząco Niska Cena</h3> </div> <div class="booklet__price-hld"> <span class="from">od</span> <span class="price"> <span class="PriceValue"><span class="CurrencyPrefix"></span><span class="CurrencyValue">305</span><span class="CurrencySeparator"></span><span class="CurrencyDecimals"></span><span class="CurrencySuffix">zł</span></span></span> <span class="rate">/noc</span> </div> <ul class="booklet__special-info"> <li> <span class="icon icon-clock"></span> <span class="label">dowolna dł. pobytu</span> </li> <li> <span class="icon icon-meal"></span> <span class="label">Bez wyżywienia</span> </li> </ul> </div> </a> </div> </div> </section> <section class="l-section l-section--two-photos is-paddington"> <div class="l-wrapper"> <div class="l-wrapper--left"> <div class="t-section-titles"> <h2 class="t-section-title">O hotelu</h2> </div> <div class="t-content"> <p>Rezydencja Luxury Hotel**** to butikowy, czterogwiazdkowy hotel na Śląsku – miejsce niepowtarzalne, łączące komfort, piękno i dobry smak.</p> <p>To idealna przestrzeń do organizacji spotkań biznesowych na najwyższym szczeblu, konferencji, bankietów oraz prywatnych przyjęć.</p> <p>Jako jeden z nielicznych hoteli w Polsce Rezydencja uzyskała ocenę 9,6/10 za czystość – na podstawie opinii Gości na portalu booking.com</p> </div> <div class="c-content-btn-hld"> <a href="/o-hotelu" target="_self"  > <span class="site-btn site-btn--bordered more" data-scroll-to="" data-scroll-px="-150px">Szczegóły</span> </a> </div> </div> <div class="l-wrapper--right"> <div class="c-images-hld"> <div class="c-img-hld c-img-hld--narrow js-img-liquid"> <img class="js-img-lazy" src="https://u.profitroom.com/2017.rezydencjahotel.pl/thumb/325x410/uploads/hotel_1.jpg" alt="O hotelu"> </div> <div class="c-img-hld c-img-hld--wide js-img-liquid"> <img class="js-img-lazy" src="https://u.profitroom.com/2017.rezydencjahotel.pl/thumb/600x410/uploads/Ogrod/galeria_1.jpg" alt="O hotelu"> </div> </div> <div class="bookingcom-hld"> <img src="/img/booking.svg" class="booking" alt="booking.com"> <span class="mark">9.6</span> <span class="on">/10</span> </div> </div> </div> </section> <section class="l-section l-section--content-with-gallery is-paddington"> <div class="l-wrapper"> <div class="l-wrapper--left"> <div class="c-images-hld js-single-gallery-slider"> <div class="c-img-hld js-img-liquid"> <img class="js-img-lazy" src="https://u.profitroom.com/2017.rezydencjahotel.pl/thumb/600x410/uploads/pokoje_1.jpg" alt="Butikowe pokoje"> </div> <div class="c-img-hld js-img-liquid"> <img class="js-img-lazy" src="https://u.profitroom.com/2017.rezydencjahotel.pl/thumb/600x410/uploads/Pokoje/Rezydencja_Luxury_Hotel_SrebrnyApartament_salon.jpg" alt="Butikowe pokoje"> </div> <div class="c-img-hld js-img-liquid"> <img class="js-img-lazy" src="https://u.profitroom.com/2017.rezydencjahotel.pl/thumb/600x410/uploads/Pokoje/Rezydencja_Luxury_Hotel_Junior_Suite_krem.jpg" alt="Butikowe pokoje"> </div> <div class="c-img-hld js-img-liquid"> <img class="js-img-lazy" src="https://u.profitroom.com/2017.rezydencjahotel.pl/thumb/600x410/uploads/Pokoje/Rezydencja_Luxury_Hotel_Pokj_Niebieski_04.jpg" alt="Butikowe pokoje"> </div> </div> </div> <div class="l-wrapper--right"> <div class="t-section-content"> <div class="t-section-titles"> <h2 class="t-section-title">Butikowe pokoje</h2> </div> <div class="t-content"> <p>Przygotowaliśmy dla Państwa 68 komfortowo urządzonych pokoi, w tym 2 eleganckie apartamenty.</p> <p>Wszystkie pokoje to starannie zaaranżowane wnętrza, harmonijnie łączące stylowe meble, szlachetne tkaniny, blask kryształowych żyrandoli i nowoczesne wyposażenie.</p> <p>To przestrzeń, w kt&oacute;rej goście konferencji, wesel i pobyt&oacute;w prywatnych mogą odpocząć w ciszy, zachowując standard butikowego hotelu premium.</p> </div> <div class="c-content-btn-hld"> <a href="/pokoje" target="_self"  > <span class="site-btn site-btn--bordered more" data-scroll-to="" data-scroll-px="-150px">Szczegóły</span> </a> </div> </div> </div> </div> </section> <section class="l-section l-section--slider-testimonials is-paddington"> <div class="l-wrapper"> <h2 class="t-section-title t-section-title--smaller">Opinie klientów</h2> <div class="a-slider-testimonials js-slider-testimonials"> <div class="a-slider-testimonials__item"> <span class="t-content">Jeden z najładniejszych hoteli w jakich byłam, czysto, cicho. Bardzo ładny pok&oacute;j z widokiem na wspaniały ogr&oacute;d. Chętnie skorzystam ponownie.
</span> <span class="author">
Aneta,                                                                            Booking.com                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Genialna kuchnia. Mogłoby się wydawać, że przykładowo w temacie hamburgera nic nie może już zaskoczyć, a tu totalne objawienie. Hotel sprawia, że po ciężkim dniu rano budzisz się wypoczęty.
</span> <span class="author">
Grzegorz,                                                                            Booking.com                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">W całym hotelu pięknie pachnie. Otoczenie bajkowe mimo bliskości trasy. Okna wygłuszone. Jedzenie w restauracji przepyszne. Do śniadania można wypić nawet szampana.
</span> <span class="author">
Agnieszka,                                                                            Booking.com                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Hotel z unikalnym charakterem. Komfortowe pokoje z bardzo wygodnymi ł&oacute;żkami. Świetne intymne spa z dostepnymi szlafrokami i wodą mineralną, można sie spokojnie zrelaksować.
</span> <span class="author">
Kosmowski.H,                                                                            Booking.com                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Przemiła atmosfera wystr&oacute;j wnętrz sprawił, że poczułam się wyjątkowo kobieco. Idealne miejsce na spędzenie miło czasu i wyciszenie się. Na pewno wr&oacute;cę by znaleźć się w innym ...</span> <span class="author">
Gosia,                                                                            Booking.com                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Sala Balowa to klasa sama w sobie, a ogr&oacute;d przecudny. Wszyscy nasi goście weselni oczarowani miejscem i obsługą, kt&oacute;ra była perfekcyjna i czuwała nad całą uroczystością.&nbsp;
</span> <span class="author">
Agnieszka,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Dziękujemy za przepyszne jedzenie, niebiańskie słodkości Pana Ryszarda, uśmiech i zaangażowanie całej obsługi nie tylko podczas przyjęcia, ale i następnego&nbsp;dnia, życzliwe podejście nie ...</span> <span class="author">
Olga & Bartłomiej,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Klasa, styl i elegancja to słowa, kt&oacute;re idealnie oddają klimat naszego wesela, wyczarowanego w Rezydencji. Jako Panna Młoda, kt&oacute;ra jest perfekcjonistką, byłam zadowolona z każdego detalu.
</span> <span class="author">
Katarzyna,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Najcudowniejszy dzień mojego życia - wesele. W tym miejscu nie mogło się nie udać! Jedzenie najlepsze na świecie, obsługa nienaganna. Pan Tomasz Antolak - najlepszy doradca na świecie.
</span> <span class="author">
Paulina,                                                                            Booking                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Dzięki fantastycznej obsłudze, szczeg&oacute;lne podziękowania dla Pani Eweliny za w pełni profesjonalną organizację, urodzinki mojej małej c&oacute;rki spędziliśmy w wyśmienitej atmosferze! ...</span> <span class="author">
Kasia,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Z całego serca polecam ❤️ piękniejszych zaślubin w ogrodzie i wesela nie jestem w stanie sobie wyobrazić. Wszystko na ekstremalnie wysokim poziomie. Dziękujemy, jeszcze wr&oacute;cimy ❤️
...</span> <span class="author">
Ewelina ,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Świetny Sylwester profesjonalnie zorganizowana impreza, naprawdę gorąco polecam wszystkim ten kameralny obiekt, polecam genialną kuchnię. Wr&oacute;cimy za rok.
</span> <span class="author">
Sebastian i Edyta,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Piękne miejsce na romantyczną kolacje, wesele, uroczystość rodziną. Jedne z najlepszych na G&oacute;rnym Śląsku. Jedzenie bardzo dobre, pięknie podane, miła obsługa.
</span> <span class="author">
Gosia,                                                                            Tripadvisor                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Przypadkiem trafiłem do tej restauracji i zaskoczenie przemiłe. Przepyszny krem z selera z białą czekoladą, pyszna rolada śląska z modra kapustą. Oj dawno takich dobrych potraw nie jadłem. Polecam!
...</span> <span class="author">
Nikodem,                                                                            Tripadvisor                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Restauracje Rezydencja polecam wszystkim, kt&oacute;rzy cenią sobie smak i elegancje. Jedno z najlepszych miejsc na kulinarnej mapie Śląska. Jedzenie warte jest swojej ceny.
</span> <span class="author">
Mr Lubon,                                                                            Tripadvisor                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Najlepsza restauracja w jakiej do tej pory byłam! Przepyszne jedzenie, wspaniała obsługa. Pozdrawiam Pana Piotra - świetnego kelnera, kt&oacute;ry swoją pracę wykonuje na 100%!
</span> <span class="author">
Pani Beata,                                                                            Google                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Bardzo się cieszymy, że to właśnie u Państwa mogliśmy ugościć naszą rodzinę i przyjaci&oacute;ł, a uśmiech i zachwyt naszej c&oacute;rki był dla nas potwierdzeniem doskonałego wyboru miejsca ...</span> <span class="author">
Agnieszka G.,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">
Z czystym sumieniem mogę polecić to miejsce wszystkim, kt&oacute;rzy szukają wyjątkowego miejsca na przyjęcie Komunijne. Rezydencja spełniła nasze oczekiwania, tort szwardzwaldzki Mistrza - ...</span> <span class="author">
Aga Giri ,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">W ubiegłą niedziele miałam przyjemność organizować przyjęcie komunijne c&oacute;rki - wszystko wypadło doskonale. Przyjęcie zorganizowane na najwyższym poziomie i z największą starannością.</span> <span class="author">
Katarzyna Niesyn ,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">10/10 Baby Shower kt&oacute;re zostało zorganizowane bezzwłocznie, jak tylko można było w tym trudnym czasie! bezcenna pomoc Pani Eweliny - nic nie stanowiło problemu /nawet dodatkowe rzeczy wymyślone ...</span> <span class="author">
Sonia Chmiel,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Organizacja Komunii Świętej była znakomita. Najwieksze uznanie dla kelnera Andrzeja, kt&oacute;ry swoją empaita i pomysłowością uratował samopoczucie gwiazdy tego dnia.
</span> <span class="author">
Joanna Markiewiczrok,                                                                            Google                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Uroczystość komunijna pięknie przygotowana, obsługa wzorowa, jedzenie bardzo smaczne, a tort przygotowany zgodnie z życzeniem piękny i r&oacute;wnie smaczny. Szczerze polecam!
</span> <span class="author">
Joanna Mizgała,                                                                            Google                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Bardzo polecam do organizowania imprezy studni&oacute;wkowej! Piękna sala robiąca niezapomniany klimat oraz obsługa kt&oacute;ra zawsze pomagała niezależnie od godziny! Profesjonalizm, dostępność ...</span> <span class="author">
Daniel Matys ,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Bardzo elegancki wystr&oacute;j, szybka obsługa i przepyszne jedzenie - to wszystko sprawiło, że nasza studni&oacute;wka była niezapomnianym przeżyciem!
</span> <span class="author">
Karolina Konieczna,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Idealne miejsce na studni&oacute;wkę, przepiękny wystr&oacute;j, wyśmienite jedzenie oraz bardzo miła obsługa to wszystko sprawiło ze wiecz&oacute;r był niezapomniany!&nbsp;
</span> <span class="author">
Natalia Markiewicz ,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Najlepsze miejsce do organizacji studni&oacute;wki, bardzo dobre jedzenie i piękny wystr&oacute;j. Kelnerzy z klasą i kulturą.&nbsp;
</span> <span class="author">
Weronika Kowolik ,                                                                            Facebook                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Postanowiłem zorganizować nasze zaręczyny w Restauracji Rezydencji i był to bardzo dobry wyb&oacute;r. Jedzenie jak zawsze przepyszne (byliśmy tutaj już niejednokrotnie i zawsze bardzo nam smakuje).</span> <span class="author">
Adrian,                                                                            Zaręczyny                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Dziękuje&nbsp; za zorganizowanie romantycznej kolacji z okazji rocznicy ślubu wszystko idealnie zrobione: piękna sala kryształowa oraz jedzenie pyszne.
Na pewno jeszcze nieraz odwiedzimy I będę ...</span> <span class="author">
Monika,                                                                            Rocznica                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Wyb&oacute;r tego miejsca na kolację walentynkową to strzał w 10! Żona zachwycona wystrojem, kuchnią oraz muzyką na żywo. Jestem mile zaskoczony istnieniem takiego miejsca na śląsku. Pomimo tego ...</span> <span class="author">
Krzysztof i Weronika,                                                                            Walentynki                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Wyśmienita kuchnia, profesjonalna obsługa, piękne wnętrza i obłędny wystr&oacute;j to wszystko sprawia, że jest to miejsce idealne na romantyczną randkę.&nbsp; Na pewno będziemy tu wracać! Kto ...</span> <span class="author">
Daga,                                                                            Randka                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Bardzo miła obsługa. Smaczne jedzenie. Ładny ogr&oacute;d. Ciekawy plac zabaw dla dzieci
&nbsp;
</span> <span class="author">
Adam,                                                                            Google                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Wspaniałe miejsce. Piękny ogr&oacute;d. Wykwintna restauracja
&nbsp;
</span> <span class="author">
Sylwia,                                                                            Google                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Ładny ogr&oacute;d, ciekawy wystr&oacute;j wnętrz, znakomite śniadania. Polecam.
</span> <span class="author">
Arleta,                                                                            Google                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Zimowa sceneria i eleganckie wnętrza Rezydencji stworzyły magiczną atmosferę. Każdy detal był perfekcyjnie dopracowany dzięki wspaniałej obsłudze.
</span> <span class="author">
Angela & David,                                                                            styczeń, 2024                                            </span> </div> <div class="a-slider-testimonials__item"> <span class="t-content">Nasze zimowe wesele w Rezydencji Luxury Hotel było jak z bajki! Profesjonalna obsługa i przepyszne jedzenie sprawiły, że ten dzień był niezapomniany.
